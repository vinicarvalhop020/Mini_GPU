#@ Processing -execute option
@genus 2> puts [info body gui_open_schematic]

  set top ""
  set pov [parse_options gui_open_schematic {} $args  "-append bos   append to last open cone schematic" append  "-name sos specifies name of the cone window" top  "drs($::nvs::instance|$::nvs::hinst|$::nvs::net|net|$::nvs::pin|$::nvs::hpin|port|$::nvs::subport|$::nvs::hpin_bus|port_bus|$::nvs::subport_bus) instance to load into cone schematic" vdir]
  
  switch -- $pov {
    -2 {return}
    0 {error "Failed on 'gui_open_schematic'."}
  } 

  switch [what_is $vdir] {
    instance - inst - hinst {
      eval gui_sv_cone_internal $args 
    }
    net - hnet {
      if {[is_halo] && $::uiHalo::new_schematic} {
          eval gui_sv_cone_net_internal $args
      }
    }
    pin - hpin - port - hport - hpin_bus - port_bus - hport_bus - pin_bus - subport - subport_bus {
      if {[is_halo] && $::uiHalo::new_schematic} {
        eval gui_sv_cone_pin_internal $args
      }
    }
  }
  return -code ok

#@ Processing -execute option
