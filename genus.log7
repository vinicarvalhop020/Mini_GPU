#@ Processing -execute option
@genus 1> puts [info body gui_show]

  set pov [parse_options [calling_proc] {} $args]

  switch -- $pov {
    -2 {return}
     0 {error "Failed on [calling_proc]"}
  }

  if {[info commands toplevel] eq "toplevel"} {
    eval halo_gui_show_internal $args
  } else {
    puts "GUI not enabled."
  }

  return -code ok

#@ Processing -execute option
@genus 2> puts [info body gui_update]

  set pov [parse_options [calling_proc] {} $args]

  switch -- $pov {
    -2 {return}
     0 {error "Failed on [calling_proc]"}
  }

  if {[info commands toplevel] eq "toplevel"} {
    ##nagelfar ignore Unknown command
    gui_sync
  }

